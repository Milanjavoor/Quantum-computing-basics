from pennylane import numpy as np
x = np.array([
    [0.2, 0.1],
    [0.3, 0.2],
    [2.5, 2.7],
    [2.7, 2.9]
])
y = np.array([
    -1,
    -1,
     1,
     1
])
import pennylane as qml
from pennylane import numpy as np
from sklearn.svm import SVC
dev=qml.device("default.qubit",wires=2)
# we create a feature map which converts the classical inputs into a quantum representation 
def feature_map(x):
    qml.RY(x[0],0)
    qml.RY(x[1],1)

    qml.CNOT([0,1])


# we use this function to create a quantum state representation of the numerical values
@qml.qnode(dev)
def Quantum_state(x):
    feature_map(x)

    return qml.state()

# We use this function 
def quantum_kernel(x1,x2):
    state1=Quantum_state(x1)
    state2=Quantum_state(x2)

    overlap=np.vdot(state1,state2)

    return np.abs(overlap)**2
def matrix(X):
    n=len(X)
    K=np.zeros((n,n))
    for i in range(n):
        for j in range(n):
            K[i][j]=quantum_kernel(X[i],X[j])
    return K
k=matrix(x)
print(k)

model=SVC(kernel="precomputed")
model.fit(k,y)

