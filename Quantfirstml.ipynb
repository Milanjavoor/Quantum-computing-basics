import pennylane as qml
from pennylane import numpy as np
data=np.array([
    [0.2, 0.1],
    [0.3, 0.2],
    [0.1, 0.3],
    [0.8, 0.9],
    [0.9, 0.7],
    [0.7, 0.8]
])
y=np.array([-1,
    -1,
    -1,
     1,
     1,
     1])
device=qml.device("default.qubit",wires=2)

@qml.qnode(device)
def Quantum(X,theta):
    qml.RY(X[0],0)
    qml.RY(X[1],1)
    qml.RY(theta[0],0)
    qml.RY(theta[1],1)
    qml.RY(theta[2],0)
    qml.CNOT([0,1])
    return qml.expval(qml.PauliX(0))
def build_qnode(n_qubits,n_layers):
    dev=qml.device("default.qubit",wires=n_qubits)
    @qml.qnode(dev,interface="torch",diff_method="backprop")
    def circuit(inputs,weights):
        wires=range(n_qubits)
        for layer in range(n_layers):
            # Create angle embedding for the inputs
            qml.AngleEmbedding(inputs,wires=wires,
                               rotation="Y")
            # form a layer using three rotation gates , and trainable weights 
            qml.StronglyEntanglingLayers(weights[layer:layer+1],
                                         wires=wires,ranges=[layer%(n_qubits-1)+1])
            return [ qml.expval(qml.PauliX(w)) for w in wires]
    return circuit

theta=np.array([0.5,0.8,0.5,0.6],requires_grad=True)
grad=qml.jacobian(Quantum)
print(grad(data,theta))
def cost(theta):
    predixt=np.array([Quantum(c,theta)
                      for c in data])
    return np.mean((predixt-y)**2)
print(cost(theta))
opt=qml.GradientDescentOptimizer(stepsize=0.1)

for i in range(100):
    theta,current_cost=opt.step_and_cost(cost,theta)
    if i%10==0:
        print("The cost for step",i,"is ",current_cost)
print("final parameters",theta)


def predict(W,thta):
    output=Quantum(W,thta)
    return 1 if output>=0 else -1
for x,target in zip(data,y):
    prediction=(predict(x,theta))
    print("Input:",x)
    print("Target:",target)
    print("Output:",prediction)
