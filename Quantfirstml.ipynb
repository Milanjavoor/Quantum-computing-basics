import pennylane as qml
from pennylane import numpy as np
data=np.array([
    [0.2, 0.1],
    [0.3, 0.2],
    [0.1, 0.3],
    [0.8, 0.9],
    [0.9, 0.7],
    [0.7, 0.8]
])
y=np.array([-1,
    -1,
    -1,
     1,
     1,
     1])
device=qml.device("default.qubit",wires=2)

@qml.qnode(device)
def Quantum(X,theta):
    qml.RY(X[0],0)
    qml.RY(X[1],1)
    qml.RY(theta[0],0)
    qml.RY(theta[1],1)
    qml.RY(theta[2],0)
    qml.CNOT([0,1])
    return qml.expval(qml.PauliX(0))

    
