import pennylane as qml
def qfun():
    qml.PauliX(0)
    qml.Hadamard(0)
    qml.Hadamard(0)
    return qml.state()
dev=qml.device("default.qubit",wires=1)
qn=qml. QNode(qfun,dev)
print(qml.draw(qn)())
print(qfun())
print(qml.draw_mpl(qn)())
sv=qn()
print(sv)
@qml.qnode(dev)
def ofun():
    qml.PauliX(0)
    qml.Hadamard(0)
    return qml.state() ,qml.probs()
print(qn())
print(ofun())
device=qml.device("default.qubit",wires=2)

@qml.qnode(device)
def circuit():
    qml.Hadamard(wires=1)
    qml.Hadamard(0)
    return qml.expval(qml.PauliX(0))

print(circuit())
