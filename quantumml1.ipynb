import pennylane as qml 
device=qml.device("default.qubit",wires=2)

@qml.qnode(device)
def Binaryclassifer(x):
    qml.RY(x[0],0)
    qml.RY(x[1],1)
    qml.CNOT([0,1])
    return qml.expval(qml.PauliX(0))
newdata={}
for i in X:
    key=float(Binaryclassifer(i))
    print(i,"->",Binaryclassifer(i))
    if key>0.5:
        newdata[key]=1
    else:
        newdata[key]=0
print(newdata)
