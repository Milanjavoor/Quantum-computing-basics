import pennylane as qml
device=qml.device("default.qubit",wires=2)
device2=qml.device("default.qubit",wires=3)

@qml.qnode(device)
def quantumfeaturemap(x):
    qml.RY(x[0],0)
    qml.RY(x[1],1)
    qml.CNOT([0,1])

    return qml.expval(qml.PauliX(0))
x=[0.2,0.7]
print(quantumfeaturemap(x))
@qml.qnode(device2)
def newmap(x):
    qml.RY(x[0],0)
    qml.RY(x[1],1)
    qml.RY(x[2],2)
    qml.CNOT([0,1])
    qml.CNOT([0,2])
    qml.CNOT([1,2])
    return qml.expval(qml.PauliX(0)),qml.expval(qml.PauliX(2))
X=[0.4,0.3,0.6]
print(newmap(X))
